@startuml Diagram_DFD_Poziom_1_Mieszkaniec
!theme plain
left to right direction
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName "Segoe UI", Arial, sans-serif

skinparam rectangle {
  BackgroundColor #0F172A
  BorderColor #1E293B
  FontColor #FFFFFF
  FontStyle bold
}

skinparam usecase {
  BackgroundColor #0369A1
  BorderColor #0284C7
  FontColor #FFFFFF
  FontStyle bold
}

skinparam database {
  BackgroundColor #FEF3C7
  BorderColor #D97706
  FontColor #92400E
  FontStyle bold
}

skinparam arrow {
  Color #0284C7
  FontColor #0F172A
  FontSize 10
}

rectangle "🎓 Mieszkaniec\n(Jan Makara)" as STUDENT

together {
  usecase "1.0\nUwierzytelnianie\n(JWT)" as P1
  usecase "2.0\nMój Pokój\ni Kwaterunek" as P2
  usecase "3.0\nRezerwacje Pralni\ni Boisk" as P3
  usecase "4.0\nZgłaszanie\nUsterek" as P4
}

together {
  database "D1: Użytkownicy\n(Users)" as D1
  database "D2: Pokoje\n(Rooms)" as D2
  database "D3: Rezerwacje\n(Reservations)" as D3
  database "D4: Usterki\n(MaintenanceTickets)" as D4
}

STUDENT --> P1 : Poświadczenia logowania
P1 <--> D1 : Weryfikacja hasła BCrypt
P1 --> STUDENT : Token JWT + Profil

STUDENT --> P2 : Zapytanie o pokój
D2 --> P2 : Metraż, czynsz, kaucja
D1 ..> P2 : Współlokatorzy
P2 --> STUDENT : Stan pokoju B-214

STUDENT --> P3 : Data, slot, obiekt
P3 <--> D3 : Weryfikacja kolizji i zapis
P3 --> STUDENT : Harmonogram i bilet

STUDENT --> P4 : Kategoria, opis, priorytet
D2 ..> P4 : Numer pokoju B-214
P4 --> D4 : Zapis usterki 'Nowe'
P4 --> STUDENT : Numer sprawy #0148

@enduml
